---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Phone from '../../components/Phone.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, index, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={`${d.title} · Jonah Fienberg`} description={d.summary}>
  <section
    class="band"
    style={`--p-bg:${d.theme.bg};--p-fg:${d.theme.fg};--p-accent:${d.theme.accent}`}
  >
    <div class="wrap band-grid">
      <div class="band-text">
        <a class="back mono rise" href={`${base}/#work`}>← All work</a>
        <p class="mono idx rise" style="--i:1">Project {pad(index + 1)}</p>
        <h1 class="rise" style="--i:2">{d.title}</h1>
        <p class="tagline rise" style="--i:3">{d.tagline}</p>
      </div>
      <div class="band-phone rise" style="--i:3">
        <Phone id={entry.id} />
      </div>
    </div>
  </section>

  <div class="wrap body">
    <aside class="facts">
      <dl>
        <div><dt class="mono">Year</dt><dd>{d.year}</dd></div>
        <div><dt class="mono">Role</dt><dd>{d.role}</dd></div>
        <div>
          <dt class="mono">Stack</dt>
          <dd>
            <ul>{d.stack.map((s) => <li>{s}</li>)}</ul>
          </dd>
        </div>
        <div>
          <dt class="mono">Status</dt>
          <dd>{d.liveUrl ? 'Live' : 'Public demo coming soon'}</dd>
        </div>
      </dl>
      <div class="links">
        {d.liveUrl && <a class="btn primary" href={d.liveUrl}>Try it ↗</a>}
        {d.repoUrl && <a class="btn" href={d.repoUrl}>Source ↗</a>}
      </div>
    </aside>

    <article class="prose">
      <p class="summary">{d.summary}</p>
      <Content />
    </article>
  </div>

  {
    next.id !== entry.id && (
      <a class="next wrap" href={`${base}/work/${next.id}/`}>
        <span class="mono">Next project</span>
        <span class="next-title">{next.data.title} →</span>
      </a>
    )
  }
</Base>

<style>
  .band {
    background: var(--p-bg);
    color: var(--p-fg);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      circle at 78% 40%,
      color-mix(in srgb, var(--p-accent) 30%, transparent),
      transparent 55%
    );
  }
  .band-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 32px;
    min-height: 560px;
  }
  .back {
    color: color-mix(in srgb, var(--p-fg) 60%, transparent);
    text-decoration: none;
  }
  .back:hover {
    color: var(--p-accent);
  }
  .idx {
    color: var(--p-accent);
    margin: 48px 0 10px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 11vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 0 0 20px;
  }
  .tagline {
    font-size: clamp(20px, 2.2vw, 27px);
    line-height: 1.3;
    max-width: 24ch;
    margin: 0 0 48px;
    color: color-mix(in srgb, var(--p-fg) 80%, transparent);
  }
  .band-phone {
    justify-self: center;
    transform: translateY(70px) rotate(4deg);
    margin-top: -20px;
  }

  .body {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(56px, 8vw, 96px);
  }
  .facts {
    position: sticky;
    top: 32px;
    align-self: start;
  }
  dl {
    margin: 0 0 28px;
  }
  dl > div {
    border-top: 1px solid var(--rule);
    padding: 12px 0;
  }
  dt {
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: 15px;
  }
  dd ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .btn {
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 18px;
    border-radius: 99px;
    border: 1px solid var(--ink);
  }
  .btn.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .prose {
    max-width: 66ch;
    font-size: 18px;
    line-height: 1.65;
  }
  .summary {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 42px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 64px 0 18px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-2);
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(ul) {
    padding-left: 1.1em;
  }
  .prose :global(li) {
    margin-bottom: 10px;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: clamp(80px, 10vw, 140px);
    text-decoration: none;
    color: var(--ink-2);
  }
  .next-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 110px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    transition: color 0.25s;
  }
  .next:hover .next-title {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .band-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .band-phone {
      transform: translateY(60px) rotate(4deg);
      margin-top: 0;
      margin-bottom: 20px;
    }
    .body {
      grid-template-columns: 1fr;
      padding-top: 100px;
    }
    .facts {
      position: static;
    }
  }
</style>
