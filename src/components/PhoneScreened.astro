---
// A hand-drawn likeness of Screened's ranked list, in the app's own palette and type.
// Swap for a real screenshot once the public build is live.
const films = [
  { t: 'Past Lives', y: 2023, s: '9.6', c: ['#6f7f8f', '#2d3440'] },
  { t: 'Parasite', y: 2019, s: '9.3', c: ['#5e6b3a', '#1f2415'] },
  { t: 'Whiplash', y: 2014, s: '8.8', c: ['#b0782f', '#3a2410'] },
  { t: 'Arrival', y: 2016, s: '8.1', c: ['#7b8b93', '#23292c'] },
  { t: 'Knives Out', y: 2019, s: '7.4', c: ['#8a4a3a', '#2a1510'] },
  { t: 'Tenet', y: 2020, s: '5.2', c: ['#3b4d6b', '#141a24'] },
];
---

<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="top">
      <span class="logo">Screened</span>
      <span class="count">48 films</span>
    </div>
    <div class="tabs"><b>Ranked</b><span>Watchlist</span><span>For you</span></div>
    <ol>
      {
        films.map((f, i) => (
          <li>
            <span class="rank">{i + 1}</span>
            <span class="poster" style={`background:linear-gradient(160deg,${f.c[0]},${f.c[1]})`} />
            <span class="meta">
              <span class="title">{f.t}</span>
              <span class="year">{f.y}</span>
            </span>
            <span class:list={['score', { loved: Number(f.s) >= 7 }]}>{f.s}</span>
          </li>
        ))
      }
    </ol>
    <div class="compare">
      <span class="q">Better or worse than <i>Arrival</i>?</span>
      <span class="btns"><span>Better</span><span>Worse</span></span>
    </div>
  </div>
</div>

<style>
  .phone {
    width: 260px;
    aspect-ratio: 9 / 19;
    border-radius: 38px;
    padding: 9px;
    background: #1b1b18;
    box-shadow:
      0 0 0 1px #3a3a30,
      0 40px 80px -20px rgba(0, 0, 0, 0.55);
  }
  .screen {
    height: 100%;
    border-radius: 30px;
    background: #0d0d0d;
    color: #f2f0ea;
    font-family: 'Schibsted Grotesk', sans-serif;
    padding: 30px 14px 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .logo {
    font-family: 'Instrument Serif', serif;
    font-size: 27px;
    line-height: 1;
  }
  .count {
    font-size: 10px;
    color: #9a978c;
  }
  .tabs {
    display: flex;
    gap: 12px;
    font-size: 10.5px;
    margin: 12px 0 8px;
    color: #9a978c;
  }
  .tabs b {
    color: #f2f0ea;
    border-bottom: 1.5px solid #c98a46;
    padding-bottom: 3px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  li {
    display: grid;
    grid-template-columns: 14px 26px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid #22221d;
  }
  .rank {
    font-size: 10px;
    color: #9a978c;
    text-align: right;
  }
  .poster {
    width: 26px;
    height: 38px;
    border-radius: 3px;
  }
  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .title {
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .year {
    font-size: 9.5px;
    color: #9a978c;
  }
  .score {
    font-size: 11px;
    font-weight: 700;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid #3a3a30;
    color: #bdb9ad;
  }
  .score.loved {
    border-color: #c98a46;
    color: #c98a46;
  }
  .compare {
    margin-top: 10px;
    background: #2a2a24;
    border-radius: 14px;
    padding: 10px;
    font-size: 11px;
  }
  .q i {
    font-family: 'Instrument Serif', serif;
    font-size: 13px;
  }
  .btns {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .btns span {
    flex: 1;
    text-align: center;
    padding: 6px 0;
    border-radius: 99px;
    background: #c98a46;
    color: #0d0d0d;
    font-weight: 700;
  }
  .btns span + span {
    background: transparent;
    color: #f2f0ea;
    border: 1px solid #3a3a30;
  }
</style>
