---
// A hand-drawn likeness of Intake's home screen, in the app's own palette.
// Swap for a real screenshot once the public demo is live.
const meals = [
  { m: 'Breakfast', d: 'Greek yogurt, granola, berries', k: 420, p: 32, c: '#3B82F6' },
  { m: 'Lunch', d: 'Chicken burrito bowl', k: 780, p: 54, c: '#F59E0B' },
  { m: 'Snack', d: 'Protein shake', k: 160, p: 30, c: '#2DD4BF' },
  { m: 'Dinner', d: 'Salmon, rice, broccoli', k: 690, p: 44, c: '#A78BFA' },
];
const kcal = meals.reduce((a, m) => a + m.k, 0);
const protein = meals.reduce((a, m) => a + m.p, 0);
const pct = Math.round((kcal / 2800) * 100);
---

<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="top">
      <span class="day">Today</span>
      <span class="date">Sun · Sep 27</span>
    </div>

    <div class="summary">
      <div class="ring" style={`--p:${pct}`}>
        <div class="ring-inner">
          <b>{kcal.toLocaleString('en-US')}</b>
          <span>of 2,800 kcal</span>
        </div>
      </div>
      <div class="side">
        <div class="stat">
          <span>Protein</span>
          <b>{protein}g</b>
          <div class="bar"><i style={`width:${Math.min(100, (protein / 170) * 100)}%`}></i></div>
        </div>
        <div class="checks">
          <span class="on">✓ Creatine</span>
          <span class="on">✓ Push day</span>
        </div>
      </div>
    </div>

    <div class="cta"><span>📷</span> Snap a meal</div>

    <ul>
      {
        meals.map((m) => (
          <li>
            <i style={`background:${m.c}`} />
            <span class="meta">
              <span class="m">{m.m}</span>
              <span class="d">{m.d}</span>
            </span>
            <span class="nums">
              <b>{m.k}</b>
              <span>{m.p}g</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .phone {
    width: 260px;
    aspect-ratio: 9 / 19;
    border-radius: 38px;
    padding: 9px;
    background: #0a0f1a;
    box-shadow:
      0 0 0 1px #334155,
      0 40px 80px -20px rgba(0, 0, 0, 0.55);
  }
  .screen {
    height: 100%;
    border-radius: 30px;
    background: #0b1220;
    color: #e6ecf5;
    font-family: 'Instrument Sans', sans-serif;
    padding: 30px 14px 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .day {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .date {
    font-size: 10px;
    color: #8594ab;
  }
  .summary {
    display: flex;
    gap: 12px;
    align-items: center;
    background: #111a2c;
    border: 1px solid #1e293b;
    border-radius: 16px;
    padding: 12px;
  }
  .ring {
    --p: 70;
    flex: none;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: conic-gradient(#3b82f6 calc(var(--p) * 1%), #1e293b 0);
    display: grid;
    place-items: center;
  }
  .ring-inner {
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: #111a2c;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .ring-inner b {
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .ring-inner span {
    font-size: 8.5px;
    color: #8594ab;
  }
  .side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stat {
    display: grid;
    grid-template-columns: 1fr auto;
    font-size: 10.5px;
    color: #8594ab;
    row-gap: 5px;
  }
  .stat b {
    color: #e6ecf5;
    font-size: 13px;
  }
  .bar {
    grid-column: 1 / -1;
    height: 5px;
    border-radius: 9px;
    background: #1e293b;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: #38bdf8;
    border-radius: 9px;
  }
  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .checks span {
    font-size: 9px;
    padding: 3px 7px;
    border-radius: 99px;
    border: 1px solid #334155;
    color: #8594ab;
  }
  .checks .on {
    color: #38bdf8;
    border-color: #1d4ed8;
    background: rgba(59, 130, 246, 0.12);
  }
  .cta {
    background: #3b82f6;
    color: white;
    font-weight: 600;
    font-size: 12px;
    text-align: center;
    padding: 10px;
    border-radius: 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 6px 1fr auto;
    gap: 9px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid #1e293b;
  }
  li i {
    width: 6px;
    height: 26px;
    border-radius: 3px;
  }
  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .m {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8594ab;
  }
  .d {
    font-size: 11.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nums {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 9.5px;
    color: #8594ab;
  }
  .nums b {
    font-size: 12px;
    color: #e6ecf5;
  }
</style>
